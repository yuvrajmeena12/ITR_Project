NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string-of-48-plus-chars
JWT_EXPIRES_DAYS=7

# Verified badge: completed + rated swaps required (clamped to 5-10)
VERIFIED_THRESHOLD=5
VERIFIED_MIN_AVG=3.5

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
# Development only: print OTP emails to the server console when SMTP is not configured
DEV_LOG_OTP=false

# SMTP (leave empty in development to use console mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SkillSwap <no-reply@skillswap.local>
